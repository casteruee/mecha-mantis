  "explode": {
    "note": "Grouped assembly explosion. Stage 1 (shell opens, 5.15-6.15): abdomen cage panes bloom out along surface normals, band rings step along the body axis, belly plates drop, coil modules slide out on their radial axes, tail slides back along its axis, wings lift off their hinges. Stage 2 (components separate, 5.5-6.5): head assembly slides off the neck pin (along the neck axis), prothorax eases out of the torso socket, abdomen slides back along its body axis, forelegs slide out on their shoulder pins (±Z). The thorax with its four walking legs stays as the central skeleton reference. Hold 6.5-7.45 (slow-motion clock 6.4-7.0). Reassembly in build order: abdomen 7.55, neck 7.62, head 7.7, forelegs 7.8, wings 7.88, shell closes last 7.9-8.55. No random debris: every rivet/gear/screw rides inside its component group.",
    "out": [5.5, 6.5],
    "rejoin": [7.55, 8.55],
    "hold": [6.5, 7.45],
    "slow": [6.4, 7.0],
    "slowRate": 0.22,
    "spin": [5.2, 8.4],
    "spinDeg": 330,
    "shell":    { "wings": [5.15, 0.6], "panes": [5.2, 0.75], "belly": [5.3, 0.6], "bands": [5.35, 0.65], "tail": [5.45, 0.55], "modules": [5.5, 0.65] },
    "shellBack": { "wings": 7.88, "panes": 7.9, "belly": 7.98, "bands": 7.95, "tail": 7.95, "modules": 8.0 },
    "groups": {
      "abdomen":   { "dir": [0.978, -0.206, 0], "dist": 2.3,  "out": 5.55, "dur": 0.85, "back": 7.55, "ret": 0.5 },
      "prothorax": { "dir": [-0.84, 0.54, 0],   "dist": 0.55, "out": 5.68, "dur": 0.7,  "back": 7.62, "ret": 0.5 },
      "head":      { "dir": [-0.84, 0.54, 0],   "dist": 1.8,  "out": 5.78, "dur": 0.7,  "back": 7.7,  "ret": 0.5 },
      "forelegR":  { "dir": [0.15, 0.1, 1],     "dist": 2.2,  "out": 5.88, "dur": 0.62, "back": 7.8,  "ret": 0.52 },
      "forelegL":  { "dir": [0.15, 0.1, -1],    "dist": 2.2,  "out": 5.88, "dur": 0.62, "back": 7.8,  "ret": 0.52 },
      "wings":     { "dir": [0, 1, 0.12],       "dist": 1.25, "out": 5.5,  "dur": 0.7,  "back": 7.88, "ret": 0.52 }
